      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Exclui um evento pelo ID. Só chame depois de o usuário confirmar a exclusão.",
        "operation": "delete",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "eventId": "={{ $fromAI('event_id', 'ID do evento obtido na listagem', 'string') }}"
      },
