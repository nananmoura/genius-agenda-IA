    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Lista eventos do Google Agenda em um período. Use para consultar a agenda e para obter o ID de um evento antes de alterar ou excluir.",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "returnAll": false,
        "limit": 50,
        "timeMin": "={{ $fromAI('data_inicio', 'Início do período, ISO 8601 com -03:00', 'string') }}",
        "timeMax": "={{ $fromAI('data_fim', 'Fim do período, ISO 8601 com -03:00', 'string') }}",
        "options": {
          "singleEvents": true,
          "orderBy": "startTime"
        }
      },
      "id": "t8",
      "name": "Agenda - listar",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        1180,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Cria um evento no Google Agenda. Só chame depois de ter título, início e fim.",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "start": "={{ $fromAI('inicio', 'Início, ISO 8601 com -03:00', 'string') }}",
        "end": "={{ $fromAI('fim', 'Fim, ISO 8601 com -03:00', 'string') }}",
        "additionalFields": {
          "summary": "={{ $fromAI('titulo', 'Título do evento', 'string') }}",
          "description": "={{ $fromAI('descricao', 'Descrição opcional, pode ser vazio', 'string') }}"
        }
      },
      "id": "t9",
      "name": "Agenda - criar",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        1320,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Altera um evento existente. Informe o ID obtido na listagem e também os valores atuais dos campos que não mudam.",
        "operation": "update",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "eventId": "={{ $fromAI('event_id', 'ID do evento obtido na listagem', 'string') }}",
        "updateFields": {
          "start": "={{ $fromAI('inicio', 'Início, ISO 8601 com -03:00', 'string') }}",
          "end": "={{ $fromAI('fim', 'Fim, ISO 8601 com -03:00', 'string') }}",
          "summary": "={{ $fromAI('titulo', 'Título do evento', 'string') }}"
        }
      },
      "id": "t10",
      "name": "Agenda - alterar",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        1460,
