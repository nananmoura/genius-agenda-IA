      "id": "b79de658-7df9-4f82-b0e9-f9d333787708",
      "name": "Eventos das próximas 25h",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        528,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YHZzxXlXczmNJI0S",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const user = $('Buscar usuário').first().json;\nconst events = $input.all()\n  .map(i => i.json)\n  .filter(e => e.id && e.start && e.start.dateTime && e.status !== 'cancelled')\n  .map(e => ({ id: e.id, title: e.summary || 'Compromisso', start: e.start.dateTime }));\nreturn [{ json: { usuario: user.usuario, offsets: user.offsets_minutes, events } }];"
      },
      "id": "38f85356-9c99-4681-92df-5e6b905efbd7",
      "name": "Montar lembretes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ev AS (\n  SELECT e->>'id' AS event_id, e->>'title' AS title, (e->>'start')::timestamptz AS start_at\n  FROM jsonb_array_elements($2::jsonb) AS e\n), off AS (\n  SELECT unnest($3::int[]) AS offset_minutes\n), wanted AS (\n  SELECT ev.event_id, ev.title, ev.start_at, off.offset_minutes,\n         ev.start_at - make_interval(mins => off.offset_minutes) AS remind_at\n  FROM ev CROSS JOIN off\n  WHERE ev.start_at - make_interval(mins => off.offset_minutes) > now() - interval '1 minute'\n), up AS (\n  INSERT INTO reminders (usuario, calendar_event_id, event_title, event_start, offset_minutes, remind_at)\n  SELECT $1::text, event_id, title, start_at, offset_minutes, remind_at FROM wanted\n  ON CONFLICT (usuario, calendar_event_id, offset_minutes) DO UPDATE\n  SET event_title = EXCLUDED.event_title,\n      remind_at = EXCLUDED.remind_at,\n      status = CASE WHEN reminders.event_start <> EXCLUDED.event_start THEN 'pending' ELSE reminders.status END,\n      event_start = EXCLUDED.event_start,\n      updated_at = now()\n  RETURNING 1\n), canc AS (\n  UPDATE reminders SET status = 'cancelled', updated_at = now()\n  WHERE usuario = $1::text AND status = 'pending'\n    AND event_start > now() AND event_start < now() + interval '25 hours'\n    AND calendar_event_id NOT IN (SELECT event_id FROM ev)\n  RETURNING 1\n)\nSELECT 1 AS ok;",
        "options": {
          "queryReplacement": "={{ [$json.usuario, JSON.stringify($json.events), '{' + $json.offsets.join(',') + '}'] }}"
        }
      },
      "id": "5796009a-7eb5-4883-b89a-720e99d7df17",
      "name": "Sincronizar lembretes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1040,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "LxvB00gCkTr5iBNv",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE reminders SET status = 'sending', attempts = attempts + 1, updated_at = now()\nWHERE id IN (\n  SELECT id FROM reminders\n  WHERE status = 'pending' AND remind_at <= now()\n  ORDER BY remind_at FOR UPDATE SKIP LOCKED LIMIT 20\n)\nRETURNING id, usuario, event_title, event_start, offset_minutes;",
        "options": {}
      },
      "id": "aba2712a-023a-4255-a487-25e0f4177fa7",
      "name": "Reservar vencidos",
